{
  "name": "voicebiz-os-enterprise",
  "version": "1.0.0",
  "description": "An enterprise-grade, AI-powered voice operating system and real-time communication platform for automated business telephony",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "node --loader tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "db:migrate": "echo 'Database migration placeholder'",
    "db:migrate:dev": "echo 'Database migration dev placeholder'",
    "db:seed": "echo 'Database seed placeholder'",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "voice",
    "enterprise",
    "communication",
    "IVR",
    "telephony",
    "AI",
    "real-time",
    "WebSocket"
  ],
  "author": "parro-183 (voiceBiz)",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "axios": "^1.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.8.0",
    "@types/jest": "^29.5.5",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "prettier": "^3.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.0",
    "tsx": "^3.14.0",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12"
  }
}
